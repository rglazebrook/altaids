3 REM WORDBREAKER FOR THE ALTAIDS COMPUTER, 2026
4 REM GUESS THE SECRET 5-LETTER WORD IN 6 TRIES.
5 REM THE .TBI ADDS LINE 1 (THE 8085 WORD DECODER, CALLED WITH USR)
6 REM AND LINE 32767 (THE PACKED WORD LIST). DON'T EDIT OR LIST THEM.
8 REM C = 1 FOR ANSI COLOR TILES, 0 FOR PLAIN TEXT MARKS
9 REM V = 1 TO ONLY ACCEPT GUESSES THAT ARE IN THE WORD LIST
10 REM N = NUMBER OF SECRET WORDS, S = DECODER SCRATCH ADDRESS
11 REM G = TYPED GUESS ADDRESS, T = GUESS NUMBER, W = GREEN COUNT
12 REM E = ESC CHARACTER, I = SCRATCH
13 REM @(1-5) SECRET WORD, @(21-46) LETTER STATUS A-Z (0 UNKNOWN,
14 REM 1 NOT IN WORD, 2 YELLOW, 3 GREEN). W = GREENS IN LAST GUESS
15 REM USR(8226) = SECRET COUNT, USR(8229,R) = UNPACK SECRET R TO S,
16 REM USR(8232,G) = 1 IF WORD AT G IS KNOWN, USR(8235) = TOTAL WORDS
17 REM USR(8238,G) MARKS GUESS G, BUILDS THE TILE LINE AT G+8 FOR PUT$
39 REM -- START HERE --
40 C=1 : V=1 : S=15936 : E=27 : N=USR(8226)
41 CLS : PRINT : PRINT ". : W O R D B R E A K E R : ." : PRINT
42 PRINT "I'M THINKING OF A 5-LETTER WORD. YOU GET 6 GUESSES."
43 PRINT "AFTER EACH GUESS I'LL MARK EVERY LETTER:" : PRINT
44 IF C PRINT $E,"[30;42m A ",$E,"[0m RIGHT LETTER, RIGHT SPOT"
45 IF C PRINT $E,"[30;43m B ",$E,"[0m IN THE WORD, WRONG SPOT"
46 IF C PRINT $E,"[30;47m C ",$E,"[0m NOT IN THE WORD"
47 IF C=0 PRINT "[A] RIGHT LETTER, RIGHT SPOT" : PRINT "(B) IN THE WORD, WRONG SPOT" : PRINT " c  NOT IN THE WORD"
48 PRINT : PRINT "I KNOW",#1,USR(8235)," WORDS.",N," OF THEM CAN BE SECRETS."
49 PRINT "PRESS ENTER TO BEGIN.", : G=FREE : GET$ G
50 RANDOMIZE : PRINT : PRINT "CHOOSING A WORD..." : I=USR(8229,RND(N))
51 FOR I=1 TO 5 : @(I)=PEEK(S+I-1) : NEXT I
52 FOR I=21 TO 46 : @(I)=0 : NEXT I
53 T=0
59 REM -- GET A GUESS --
60 PRINT : PRINT "GUESS ",$T+49,": ", : GET$ G
61 IF Z<>6 PRINT "PLEASE TYPE A 5-LETTER WORD." : GOTO 60
66 IF V IF USR(8232,G)=0 PRINT "I DON'T KNOW THAT WORD." : GOTO 60
67 T=T+1 : W=USR(8238,G) : PUT$ G+8 : PRINT
88 IF W=5 GOTO 95
89 IF T<6 GOTO 60
90 PRINT : PRINT "OUT OF GUESSES! THE WORD WAS ",
91 FOR I=1 TO 5 : PRINT $@(I), : NEXT I : PRINT : GOTO 97
95 PRINT : PRINT "SOLVED IN ",$T+48," OF 6 GUESSES!"
97 PRINT : PRINT "PLAY AGAIN (Y/N)? ", : GET$ G
98 IF (PEEK(G)="Y")+(PEEK(G)="y") GOTO 50
99 PRINT "THANKS FOR PLAYING!" : END
