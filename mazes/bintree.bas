1 REM BINARY TREE MAZE GENERATOR
10 CLS : PRINT : PRINT "BINARY TREE MAZE GENERATOR" : PRINT 
20 INPUT "NUMBER OF ROWS (ODD ONLY!)" R
30 INPUT "NUMBER OF COLS (ODD ONLY!)" C : PRINT "GENERATING..." : PRINT
40 DIM M(R*C):FOR V=1 TO R STEP 2:FOR H=1 TO C STEP 2:Z=(V-1)*C+H:M(Z)=1
50 IF (H=C)*(V=R) GOTO 120
60 IF (H=C) GOTO 100
70 IF (V=R) GOTO 90
80 RANDOMIZE : A=RND(100) : IF A<=50 GOTO 100
90 M(Z+2)=1 : M(Z+1)=1  : GOTO 110
100 M(Z+2*C)=1 : M(Z+C)=1
110 NEXT H : NEXT V 
120 PRINT $14,$97,$32, : FOR H=1 TO C : PRINT $97, : NEXT H : PRINT
130 FOR V=1 TO R : PRINT $97, : FOR H=1 TO C : Z=(V-1)*C+H
140 IF M(Z)=1 PRINT $32, : GOTO 160
150 PRINT $97,
160 NEXT H : PRINT $97,"" : NEXT V
170 FOR H=1 TO C : PRINT $97, : NEXT H : PRINT $32,$97,$15 
180 PRINT : PRINT : GOTO 20



1 REM BINARY TREE MAZE GENERATOR
10 CLS : @(0)=97: @(1)=32 : PRINT "BINARY TREE MAZE GENERATOR" : PRINT
20 INPUT "NUMBER OF ROWS (ODD ONLY!)" R
30 INPUT "NUMBER OF COLS (ODD ONLY!)" C : PRINT "GENERATING..." : PRINT
40 PRINT $14,$97,$32, : FOR X=1 TO C : PRINT $97, : NEXT X : PRINT
50 DIM M(R*C):FOR V=1 TO R STEP 2:FOR H=1 TO C STEP 2:Z=(V-1)*C+H:M(Z)=1
60 IF (H=C)*(V=R) GOTO 160
70 IF (H=C) GOTO 110
80 IF (V=R) GOTO 100
90 RANDOMIZE : A=RND(100) : IF A<=50 GOTO 110
100 M(Z+2)=1 : M(Z+1)=1  : GOTO 120
110 M(Z+2*C)=1 : M(Z+C)=1 
120 NEXT H : PRINT $97, : FOR X=1 TO C : IF M((V-1)*C+X) PRINT $32, : GOTO 140 
130 PRINT $97,
140 NEXT X : PRINT $97 :  NEXT V 
160 FOR X=1 TO C : PRINT $97, : NEXT X : PRINT $32,$97,$15 
170 PRINT : PRINT $15 : GOTO 20


1 REM BINARY TREE MAZE GENERATOR
10 CLS:DIMW(2):W(1)=97:W(2)=32:PR."BINARY TREE MAZE GENERATOR":PR.
20 IN."NUMBER OF ROWS (ODD ONLY!)" R
30 IN."NUMBER OF COLS (ODD ONLY!)" C:PR."GENERATING...":PR.
40 PR.$14,$97,$32,:F.X=1 TO C:PR.$97,:N.X:PR.
50 DIM M(R*C):F.V=1TORSTEP2:F.H=1 TO C STEP 2:Z=(V-1)*C+H:M(Z)=1
60 IF (H=C)*(V=R) GOTO 130
70 IF (H=C) GOTO 110
80 IF (V=R) GOTO 100
90 RANDOMIZE:A=RND(100):IF A<=50 GOTO 110
100 M(Z+2)=1:M(Z+1)=1:GOTO 120
110 M(Z+2*C)=1 : M(Z+C)=1 
120 N.H:F.Y=0TO1:PR.$97,:F.X=1TOC:PR.$W(M((V-1+Y)*C+X)+1),:N.X:PR.$97:N.Y:N.V
130 F.X=1TOC:PR.$97,:N.X:PR.$32,$97,$15:PR.:GOTO20
