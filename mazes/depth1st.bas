1 REM DEPTH-FIRST MAZE ALGORITHM
2 REM M = MAZE ARRAY, V = VISITED CELLS, I = ITERATOR, D = DEPTH COUNT
3 REM X = COL COUNT, Y = ROW COUNT, R = CURRENT ROW, C = CURRENT COL
4 GO.10
5 F.I=1TOX*2+1:PR.$97,:N.I:PR.:RETURN
10 RANDOMIZE:CLS:PR."DEPTH-FIRST MAZE":IN."COLUMNS"X:IN."ROWS"Y
20 PR."INITIALIZING...",:T=X*Y:D.M(T):D.V(T):F.I=1TOT:M(I)=1:N.I
30 M(1)=0:V(1)=1:D=1:PR.$14:CLS
40 REM INITIAL DRAW?
50 GOS.5:PR.:F.I=1TOT:R=(I-1)/X:C=(I-1)%X:IF(C=0)PR.$97,
60 PR.$((M(I)*2+1)*32+M(I)),$97,:IFC=X-1PR.:GOS.5
70 N.I:GOS.5:PR.

