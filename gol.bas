1 REM CONWAY'S GAME OF LIFE, PALO ALTAIDS TINY BASIC VERSION
2 REM A = PREVIOUS GEN, B = CURRENT GEN, I = ITERATOR, G = GEN COUNT
3 REM R = ROW, C = COL, N = NEIGHBORS, S = SUBTOTAL CELL COUNT
4 REM H = HOR CELL COUNT, V = VERT CELL COUNT, T = TOTAL CELL COUNT
5 CLS:PR."CONWAY'S GAME OF LIFE":PR.
6 IN."HOW MANY COLS"H:IN."HOW MANY ROWS"V
7 T=H*V:D.A(T):D.B(T):N=0:G=1:RANDOMIZE
8 F.I=1TOT:A(I)=RND(2)-1:N.I:CLS
9 PR.$27,"[H","GENERATION ",#3,G,":":F.I=1TOH+2:PR."_",:N.I:PR.
10 F.I=1TOT:R=(I-1)/H:C=(I-1)%H:IFC=0PR."|",
11 IFRN=A(I-H):IFCN=N+A(I-H-1):IF(C<(H-1))N=N+A(I-H+1)
12 IFCN=N+A(I-1):IF(C<(H-1))N=N+A(I+1)
13 IF(R<(V-1))N=N+A(I+H):IFCN=N+A(I+H-1):IF(C<(H-1))N=N+A(I+H+1)
14 B(I)=(A(I)+N=3)+(A(I)*(N=3)):PR.$((B(I)+1)*32),
15 N=0:IFC=H-1PR."|"
16 N.I:F.I=1TOH+2:PR."-",:N.I:F.I=1TOT:A(I)=B(I):B(I)=0:N.I
17 G=G+1:GO.9
