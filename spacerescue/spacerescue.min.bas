3 S=0:CLS:PR.:PR."            .:. INTERGALACTIC SPACE RESCUE .:.":PR.
4 PR."YOU ARE THE CAPTAIN OF A RESCUE SHIP. YOU MUST TRAVEL FROM"
5 PR."SECTOR TO SECTOR, RESPONDING TO THE DISTRESS CALLS OF STRANDED"
6 PR."STARSHIPS, SEEKING THEM OUT AND RESCUING THEIR PASSENGERS."
7 PR."BEWARE: ASTEROID FIELDS AND WORMHOLES MAKE THESE SECTORS DANGEROUS!"
8 PR.:PR.#1+(S>9),"TRAVELING TO SECTOR ",S,"...",:GOS.10:GOS.15:GOS.28:GOTO8
10 X=2+40*S:FORY=0TO99:GOS.47:@(Y)=P:N.Y
11 Q=RND(100)-1:R=Q:PR.".",:GOS.43:IFT<>0GOTO11
12 Q=RND(100)-1:W=Q:PR.".",:GOS.43:IFT<>0GOTO12
13 GOS.48:IFD<>10GOTO11
14 F=18:PR.:RET.
15 GOS.48:PR.:PR.#2, "SECTOR: ",S,
16 PR.#1, "    |    LOCATION: ",R-R/10*10,",",R/10,
17 PR.#2, "    |    SIGNAL DISTANCE: ",D,
18 PR.#2, "    |    FUEL: ",F:PR.
19 IN."MOVE (2=DOWN 4=LEFT 6=RIGHT 8=UP)"M
20 IF(M<>2)*(M<>4)*(M<>6)*(M<>8)+(M=2)*(R>=90)+(M=8)*(R<10)GOTO19
21 Y=R-R/10*10:IF(M=4)*(Y=0)+(M=6)*(Y=9)GOTO19
22 PR.:IFM=2 R=R+10
23 IFM=4 R=R-1
24 IFM=6 R=R+1
25 IFM=8 R=R-10
26 Q=R:GOS.43:GOS.37+T:IF(R<>W)*(F>0)GOTO15
27 RET.
28 IFF>0GOTO31
29 PR."YOU RUN OUT OF FUEL AND NEED TO BE RESCUED."
30 PR."SOMEWHAT EMBARASSED, YOU RET. TO HELP ANOTHER SHIP.":RET.
31 IFS=99GOTO35
32 S=S+F:IFS>99 S=99
33 PR."YOU FOUND THE STRANDED STARSHIP AND RESCUED THE PASSENGERS!"
34 PR.#1+(S>9), "RECEIVING DISTRESS SIGNAL FROM SECTOR ",S,"!":RET.
35 PR."SUCCESS! THE FINAL STRANDED PASSENGERS BOARD YOUR SHIP."
36 PR."ENJOY YOUR WELL-DESERVED RETIREMENT, CAPTAIN.":END
37 PR."YOU ARE IN DEEP SPACE.":F=F-1:RET.
38 PR."YOU LAND ON A NEARBY PLANET AND FUEL UP.":F=18:RET.
39 PR."YOU DODGE ASTEROIDS, BURNING FUEL!":GOS.47:F=X-X/F*F:RET.
40 PR."WORMHOLE! YOU ARE TRANSPORTED TO ANOTHER PART OF THE SECTOR...",
41 RA.:Q=RND(100)-1:PR.".",:GOS.43:IF(Q=R)+(T<>3)GOTO41
42 R=Q:F=F-1:PR.:RET.
43 P=@(Q):T=0:IFP<10 T=1
44 IF(T=0)*(P<20+S*1/10) T=2
45 IF(T=0)*(P<30+S*2/10) T=3
46 RET.
47 X=5*X+31:X=X-X/4096*4096:P=X-X/100*100:RET. 
48 D=ABS((R-R/10*10)-(W-W/10*10))+ABS(R/10-W/10):RET.
