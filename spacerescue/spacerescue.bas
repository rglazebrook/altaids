1 REM INTERGALACTIC SPACE RESCUE, ALTAIDS VERSION 2024 BY ROB GLAZEBROOK
2 REM MODIFIED FROM DAMIAN GARETH WALKER'S 2019 PUBLIC DOMAIN VERSION
3 REM D = DISTANCE TO SHIP, S = SECTOR, L = LOCATION COUNTER
4 REM P = POSITION SEED, Q = QUADRANT / LOCATION, F = FUEL
5 REM X = SECTOR SEED, Y = TEMP STORAGE, T = LOCATION TYPE
6 REM R = RESCUE SHIP LOCATION, W = WRECKED SHIP LOCATION

10 S=0 : CLS : PRINT
11 PRINT "            .:. INTERGALACTIC SPACE RESCUE .:." : PRINT
12 PRINT "YOU ARE THE CAPTAIN OF A RESCUE SHIP. YOU MUST TRAVEL FROM"
13 PRINT "SECTOR TO SECTOR, RESPONDING TO THE DISTRESS CALLS OF STRANDED"
14 PRINT "STARSHIPS, SEEKING THEM OUT AND RESCUING THEIR PASSENGERS."
15 PRINT "BEWARE: ASTEROID FIELDS AND WORMHOLES MAKE THESE SECTORS DANGEROUS!"

16 PRINT : PRINT#1+(S>9),"TRAVELING TO SECTOR ",S,"...",
17 GOSUB 20 : GOSUB 25 : GOSUB 40 : GOTO 16

20 X=2+40*S : FOR Y=0 TO 99 : GOSUB 64 : @(Y)=P : NEXT Y : REM SECTOR SETUP
21 Q=RND(100)-1 : R=Q : PRINT ".", : GOSUB 60 : IF T<>0 GOTO 21
22 Q=RND(100)-1 : W=Q : PRINT ".", : GOSUB 60 : IF T<>0 GOTO 22
23 GOSUB 65 : IF D<>10 GOTO 21
24 F=18 : PRINT : RETURN

25 REM MAIN SECTOR LOOP
26 GOSUB 65 : PRINT : PRINT#2, "SECTOR: ",S,
27 PRINT#1, "    |    LOCATION: ",R-R/10*10,",",R/10,
28 PRINT#2, "    |    SIGNAL DISTANCE: ",D,
29 PRINT#2, "    |    FUEL: ",F : PRINT
30 INPUT "MOVE (2=DOWN 4=LEFT 6=RIGHT 8=UP)" M
31 IF (M<>2)*(M<>4)*(M<>6)*(M<>8) GOTO 30
32 IF (M=2)*(R>=90)+(M=8)*(R<10) GOTO 30
33 Y=R-R/10*10 : IF (M=4)*(Y=0)+(M=6)*(Y=9) GOTO 30
34 PRINT : IF M=2 R=R+10
35 IF M=4 R=R-1
36 IF M=6 R=R+1
37 IF M=8 R=R-10
38 Q=R : GOSUB 60 : GOSUB 51+T : IF (R<>W)*(F>0) GOTO 25
39 RETURN

40 REM DETERMINE GAME OVER STATE
41 IF F>0 GOTO 44
42 PRINT "YOU RUN OUT OF FUEL AND NEED TO BE RESCUED."
43 PRINT "SOMEWHAT EMBARASSED, YOU RETURN TO HELP ANOTHER SHIP." : RETURN
44 IF S=99 GOTO 48
45 S=S+F : IF S>99 S=99
46 PRINT "YOU FOUND THE STRANDED STARSHIP AND RESCUED THE PASSENGERS!"
47 PRINT#1+(S>9), "RECEIVING DISTRESS SIGNAL FROM SECTOR ",S,"!" : RETURN
48 PRINT "SUCCESS! THE FINAL STRANDED PASSENGERS BOARD YOUR SHIP."
49 PRINT "ENJOY YOUR WELL-DESERVED RETIREMENT, CAPTAIN." : END

50 REM LOCATION DESCRIPTIONS AND ACTIONS
51 PRINT "YOU ARE IN DEEP SPACE." : F=F-1 : RETURN
52 PRINT "YOU LAND ON A NEARBY PLANET AND FUEL UP." : F=18 : RETURN
53 PRINT "YOU DODGE ASTEROIDS, BURNING FUEL!" : GOSUB 64 : F=X-X/F*F : RETURN
54 PRINT "WORMHOLE! YOU ARE TRANSPORTED TO ANOTHER PART OF THE SECTOR...",
55 RANDOMIZE : Q=RND(100)-1 : PRINT ".", : GOSUB 60 : IF (Q=R)+(T<>3) GOTO 55
56 R=Q : F=F-1 : PRINT : RETURN

59 REM DETERMINE WHAT IS AT QUADRANT "Q"
60 P=@(Q) : T=0 : IF P<10 T=1 : REM PLANETS ~10%
61 IF (T=0)*(P<20+S*1/10) T=2 : REM ASTEROIDS ~10-19%
62 IF (T=0)*(P<30+S*2/10) T=3 : REM WORMHOLES ~10-19%
63 RETURN

64 X=5*X+31 : X=X-X/4096*4096 : P=X-X/100*100 : RETURN 
65 D=ABS((R-R/10*10)-(W-W/10*10))+ABS(R/10-W/10) : RETURN
