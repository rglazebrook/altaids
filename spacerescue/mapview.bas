1 REM VIEW ANY SECTOR MAP GENERATED BY THE SPACE RESCUE ALGORITHM
2 REM SPACE = EMPTY, P = PLANET, A = ASTEROIDS, W = WORMHOLE
10 INPUT "WHAT SECTOR" S
15 PRINT " 0123456789",
20 X=2+40*S : FOR Y=0 TO 99 
25 R=Y-Y/10*10 : IF R=0 PRINT : PRINT#1,Y/10,
30 GOSUB 50 : IF R=9 PRINT#1,Y/10, 
35 NEXT Y
40 PRINT : PRINT " 0123456789" : PRINT : GOTO 10
50 X=5*X+31 : X=X-X/4096*4096 : P=X-X/100*100 
60 IF P<10 PRINT "P", : RETURN
70 IF P<20+S*1/10 PRINT "A", : RETURN
80 IF P<30+S*2/10 PRINT "W", : RETURN
90 PRINT " ", : RETURN
