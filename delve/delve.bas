1 REM DELVE, 2024 BY ROB GLAZEBROOK
2 REM WRITTEN FOR THE ALTAIDS COMPUTER IN PALO ALTAIDS TINY BASIC
3 REM P = PLAYER LOCATION
4 REM L = LEVEL
5 REM R = RANDOM TOGGLE (1 = STANDARD CAMPAIGN, ANY OTHER # RANDOMIZES)
6 REM A = ATTACK STRENGTH
7 REM S = SPEED
8 REM H = HEALTH
9 REM X = LEVEL SEED
10 REM G = GEM LOCATION
11 REM D = STAIRS DOWN LOCATION
12 REM C = GEM COUNT
13 REM Q = LOCATION TO CHECK
14 REM Y = CELL SEED /  TEMP
15 REM T = CONTENTS OF A LOCATION
16 REM E = DISTANCE BETWEEN PLAYER AND GEM
17 REM F = DISTANCE BETWEEN PLAYER AND STAIRS
18 REM O = TEMP 
19 REM B = BADDIE HEALTH

20 REM INITIAL VARIABLE SETUP
21 L=1 : A=3 : S=10 : H=100 : C=0 : CLS : PR.

100 PR."                         THE BADDIES OF CUBE CAVE"
110 PR."                           ROB GLAZEBROOK, 2024" : PR. : PR.
120 PR."       BADDIES HAVE STOLEN THE 10 GLOWING GEMS THAT KEEP YOUR TOWN"
130 PR."      SAFE FROM THE SPOOKY THINGS IN THE NIGHT. THEY'VE STASHED THE"
140 PR."      GEMS ACROSS ALL 10 FLOORS OF THEIR HIDEOUT: CUBE CAVE! YOU'VE" 
150 PR."      VOLUNTEERED TO FIND THE GEMS AND TEACH THOSE BADDIES A LESSON."
160 PR.:PR."                            BEST OF LUCK, HERO." : PR.

170 PR.#2, "ENTERING CAVE FLOOR ", L, "...",
180 REM THE GAME LOOP
190 GOS. 300 : GOS. 500 : GOS. 1000 : GOTO 170

300 REM SET UP THE LEVEL
310 X=2+L*41
320 FOR Q=0 TO 99 : GOS. 400 : NEXT Q : PR. ".",
335 REM PLACE THE PLAYER
330 Q=RND(100)-1 : P=Q : PR. ".", : IF @(Q)<>0 GOTO 330
335 REM PLACE THE GEM THE SAME WAYw
340 Q=RND(100)-1 : G=Q : IF @(Q)<>0 GOTO 340
345 REM PLACE THE STAIRS THE SAME WAY
350 Q=RND(100)-1 : D=Q : IF @(Q)<>0 GOTO 350
355 REM ENSURE WE'RE NOT IMMEDIATELY NEXT TO EITHER
360 GOS. 930 : IF(E<5)+(F<5) GOTO 330
370 REM SET THE GEM AND STAIR LOCATONS IN OUR LEVEL DATA
380 @(G)=50 : @(D)=60 : PR. : RET.

400 REM SET THE CONTENTS OF THE CURRENT LOCATION
410 GOS. 910 : T=0 : IF (Y<10-L/2) T=10 : REM 10-5% CHANCE OF HEALTH
420 IF (T=0)*(Y<15-L/2) T=20 : REM 5% CHANCE OF STRENGTH POTION
430 IF (T=0)*(Y<20-L/2) T=30 : REM 5% CHANCE OF SPEED POTION
440 IF (T=0)*(Y>92-L*2) T=40 : REM 20-30% CHANCE OF ENCOUNTERING A BADDIE 
450 @(Q)=T : RET.

499 REM THE LEVEL LOOP
500 T=@(P) : GOS. 600
515 GOS. 700+T : PR.
520 IF (H<=0)+(C=L)*(T=60) RET.
525 INPUT "MOVE (2=DOWN 4=LEFT 6=RIGHT 8=UP)" O
530 IF (O<>2)*(O<>4)*(O<>6)*(O<>8) PR. "THAT'S NOT A DIRECTION.":GOTO 525
535 IF (O=2)*(P>89)+(O=8)*(P<10) PR. "YOU HIT A WALL.":GOTO 525
540 Y=P-P/10*10:IF (O=4)*(Y=0)+(O=6)*(Y=9) PR. "YOU HIT A WALL.":GOTO 525
545 IF O=2 P=P+10
550 IF O=4 P=P-1
555 IF O=6 P=P+1
560 IF O=8 P=P-10
570 GOTO 500

599 REM SHOW THE STATUS BAR
600 PR. : PR.#2+(H>99), "HEALTH: ",H,
610 PR.#1+(A>9),"   STRENGTH: ",A,
620 PR.#1+(A>9),"   SPEED: ",S,
630 GOS. 930 : O=9-E : IF O<0 O=0
640 PR.#1,"   LIGHT: ",O, : O=9-F : IF O<0 O=0
650 PR.#1, "   NOISE: ",O
660 PR.#1, "LOCATION ",P-P/10*10,",",P/10,": ", : RET.

699 REM THE ROOM DESCRIPTIONS AND ACTIONS
700 PR. "THERE'S NOTHING SPECIAL HERE.":RET. 
710 PR. "YOU FIND A BLUE POTION; YOU ARE HEALED.":H=100:@(P)=0:RET.
720 PR. "YOU FIND A RED POTION; YOU FEEL STRONGER.":A=A+3:@(P)=0:RET.
730 PR. "YOU FIND A GREEN POTION; YOU FEEL FASTER.":S=S+3:@(P)=0:RET.
740 PR. "YOU ENCOUTER A BADDIE!":FORO=1TO999:NEXTO:GOS. 800:@(P)=0:RET.
750 PR. $7,"YOU LOCATE ONE OF THE GLOWING GEMS!":C=C+1:@(P)=0
755 PR. "NOW YOU NEED TO FIND THE STAIRS TO THE NEXT LEVEL.":RET.
760 PR. "YOU LOCATE THE STAIRS DOWN TO THE NEXT LEVEL."
765 PR. "THE MURMURS OF THE BADDIES BELOW ECHO UP TO YOU."
770 IF C<>L PR. "UNFORUNATELY, YOU HAVEN'T FOUND THE GEM YET.":RET.
780 RET.

799 REM BADDIES HAVE 35+L*5 H, 7+L*3 SPEED, L*3 + 1D4 STRENGTH
800 B=35+L*5
810 O=RND(100):IF O<=7+L*3 PR. "THE BADDIE DODGES YOUR ATTACK.":GOTO 840
820 O=RND(6)+A:PR. "YOU",:GOS. 880:PR.#2," THE BADDIE FOR ",O," DAMAGE!"
830 B=B-O : IF B<=0 GOTO 890
840 FORO=1TO2000:NEXTO
850 O=RND(100) : IF O<=S PR. "YOU DODGE THE BADDIE'S ATTACK." : GOTO 875
860 O=RND(4)+L*3 : PR."THE BADDIE",:GOS.880:PR.#2,"S YOU FOR ",O," DAMAGE!"
870 H=H-O : IF H<=0 RET.
875 FORO=1TO2000:NEXTO:GOTO 890 
880 IF O<6 PR. " FLICK", : RET.
881 IF O<12 PR. " SMACK", : RET.
882 IF O<20 PR. " HIT", : RET.
883 IF O<30 PR. " SLAM", : RET.
884 IF O<42 PR. " REAM", : RET.
885 PR. " DESTROY", : RET.
890 IF B<=0 PR.$7,"YOU KNOCKED THE BADDIE OUT!" : GOS. 600 : RET.
895 PR.#3, "YOUR HEALTH: ",H," BADDIE HEALTH: ",B:FORO=1TO1000:NEXTO:GOTO 810

900 REM UPDATE THE SEED
910 X=3*X+39 : X=X-X/4096*4096 : Y=X-X/100*100 : RET.

920 REM FIND DISTANCE BETWEEN PLAYER AND GEM/STAIRS
930 E=ABS((P-P/10*10)-(G-G/10*10))+ABS(P/10-G/10):IF C=L E=999
940 F=ABS((D-D/10*10)-(P-P/10*10))+ABS(D/10-P/10) : RET.

1000 REM LEVEL / GAME OVER STATES
1010 IF H>0 GOTO 1030
1020 PR. "YOU CRUMPLE TO THE GROUND AND EVERYTHING GOES DARK..." 
1025 PR. "BETTER LUCK NEXT TIME." : END
1030 IF C<10 GOTO 1050
1040 PR. $7,"THAT'S THE LAST GEM! YOU CLIMB BACK OUT OF CUBE CAVE AND RETURN"
1045 PR. "TO TOWN VICTORIOUS! WELL DONE, HERO." : END
1050 PR. $7,"YOU CLIMB DOWN THE STAIRS TO FIND THE NEXT GEM.":L=L+1:RET.
