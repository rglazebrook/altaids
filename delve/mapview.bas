1 REM VIEW ANY CAVE LEVEL GENERATED BY THE BADDIE ALGORITHM
2 REM SPACE = EMPTY, B = BADDIE, A = STRENGTH, S = SPEED, H = HEALTH
3 CLS
10 INPUT "WHAT LEVEL" L
15 PRINT " 0123456789",
20 X=2+L*41 : FOR A=0 TO 99 
25 O=A-A/10*10 : IF O=0 PRINT : PRINT#1,A/10,
30 GOSUB 50 : IF O=9 PRINT#1,A/10, 
35 NEXT A
40 PRINT : PRINT " 0123456789" : PRINT : GOTO 10
50 X=3*X+39 : X=X-X/4096*4096 : Y=X-X/100*100
60 IF (Y<10-L/2) PRINT "H", : RETURN
70 IF (Y<15-L/2) PRINT "A", : RETURN
80 IF (Y<20-L/2) PRINT "S", : RETURN
90 IF (Y>92-L*1) PRINT "B", : RETURN
100 PRINT " ", : RETURN
